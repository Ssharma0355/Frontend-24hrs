import { useState,useEffect } from 'react'
function TrafficLight({config}){
  const [index, setIndex] = useState(0)
  const traffic = config[index]
  useEffect(()=>{
    const timer=setTimeout(()=>{
      setIndex((prev)=>(prev+1)%config.length)

    },config[index].duration)

    return()=>{clearTimeout(timer)}
  },[traffic])
  return(
    <div>{config.map(c=>(
      <div style={{border:"1px solid black", width:"50px",
      height:"50px",borderRadius:"100%",margin:"12px",
       padding:"12px", backgroundColor:`${c.id===index?c.color:""}
       `}} key={c.id}><p style={{textAlign:"center",size:"12px", fontWeight:"20"}}>{c.id===index?c.message:""}</p></div>
    ))}</div>

  )
}
export default TrafficLight
